# Only mod_rewrite lines: hosts that restrict .htaccess reject Options, DirectoryIndex and Header lines with
# "Internal Server Error". HTTPS: turn on the host's "Force HTTPS"; the app adds its security headers.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # never serve hidden files such as .env
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # the app's pages go through Laravel (also the home page)
    RewriteRule ^$ index.php [L]
    RewriteRule ^index\.html$ index.php [L]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
