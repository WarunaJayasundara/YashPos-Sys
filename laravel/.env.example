# YASH MOBILE POS settings. On the server: rename this file to .env and fill in the lines marked <-.

APP_NAME="YASH MOBILE POS"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# <- your address, e.g. https://pos.yourdomain.com
APP_URL=http://localhost

# <- database from cPanel > MySQL Databases (names start with your cPanel user name)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpuser_yashpos
DB_USERNAME=cpuser_posuser
DB_PASSWORD=
DB_TIMEZONE=+00:00

# <- owner account password, used once by /install (empty it afterwards)
SEED_ADMIN_PASSWORD=
# secret for https://yourdomain/install?key=... (create/update the database from the browser)
INSTALL_KEY=

# <- low-stock emails: an email account made in cPanel > Email Accounts (e.g. pos@yourdomain.com)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=pos@yourdomain.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="pos@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# 1 = HTTPS only (keep 1 on the internet; 0 only for http://localhost)
COOKIE_SECURE=1
# 1 only when the site sits behind a proxy such as Cloudflare
TRUST_PROXY=0
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT=10
# Sri Lanka = +5:30 = 330 minutes
TZ_OFFSET_MINUTES=330

# Laravel internals (no need to change)
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
