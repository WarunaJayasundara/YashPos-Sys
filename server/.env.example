# MySQL / MariaDB connection. Use a dedicated user with a strong password in production.
DATABASE_URL="mysql://pos_user:CHANGE_ME@127.0.0.1:3306/yash_pos"
PORT=4000
# Login session lifetime
SESSION_TTL_HOURS=12
# Frontend origin (only needed when the client is served from another origin)
CORS_ORIGIN=http://localhost:5173
NODE_ENV=production
# Set to 1 behind HTTPS so cookies are marked Secure
COOKIE_SECURE=0
# Initial owner account created by the seed (change the password after first login)
SEED_ADMIN_PASSWORD=
